/build/

# The unpacked games, imported from the user's own CHDs.
# Game material, so it can never be committed; the extension bans below would
# catch most of it, but this is the rule that is actually meant.
/data/

# Written by `make pack`, always, in whichever tree the build ran. It is the
# user's: tuned ini, both dumps, NVRAM, and none of it is reproducible from this
# repository. `make clean` does not touch it. `git clean -xdf` WOULD: it deletes
# ignored files by definition, so use `git clean -xdf -e /run/`.
/run/

*.log

# Snapshots belong in git history, not in the tree.
/archive/

__pycache__/
*.pyc

# Belt and braces. This repository has no reason to contain a binary, a game
# asset, a disk image or an archive, and every one of those has a way of
# arriving by accident.
#
# `chd/` is what the user supplies: their own CHDs. The README explaining the
# directory is kept; anything dropped in is not.
/chd/*
!/chd/README.md
*.chd
*.exe
*.dll
*.img
*.iso
*.rar
*.zip
*.7z
*.r2
*.csh
*.nvr
*.omf
*.bin
!res/*.ico
