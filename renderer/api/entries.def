VGL_ENTRY(grGammaCorrectionValue,           4,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grGlideGetState,                  4,  PL_STATE_OUT,                    ST_NONE)
VGL_ENTRY(grGlideInit,                      0,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grGlideSetState,                  4,  PL_STATE_IN,                     ST_DRAW)
VGL_ENTRY(grGlideShutdown,                  0,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grHints,                          8,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grLfbConstantAlpha,               4,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grLfbConstantDepth,               4,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grLfbLock,                       24,  PL_LFBINFO,                      ST_NONE)
VGL_ENTRY(grLfbUnlock,                      8,  PL_LFBUNLOCK,                    ST_NONE)
VGL_ENTRY(grLfbWriteColorFormat,            4,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSplash,                        20,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSstIdle,                        0,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSstOrigin,                      4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grSstQueryHardware,               4,  PL_HWCFG,                        ST_NONE)
VGL_ENTRY(grSstSelect,                      4,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSstStatus,                      0,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSstVidMode,                     8,  PL_VIDTIMING,                    ST_NONE)
VGL_ENTRY(grSstWinClose,                    0,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grSstWinOpen,                    28,  PL_WINOPEN,                      ST_NONE)
VGL_ENTRY(grTexClampMode,                  12,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grTexCombine,                    28,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grTexCombineFunction,             8,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grTexDetailControl,              16,  PL_NONE,                         ST_NONE)
VGL_ENTRY(grTexDownloadMipMap,             16,  PL_TEXDOWN,                      ST_DRAW)
VGL_ENTRY(grTexDownloadMipMapLevelPartial, 40,  PL_TEXPART,                      ST_DRAW)
