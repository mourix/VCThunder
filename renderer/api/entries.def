VGL_ENTRY(grDepthBiasLevel,                 4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDepthBufferFunction,            4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDepthBufferMode,                4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDepthMask,                      4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDisableAllEffects,              0,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDitherMode,                     4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grDrawLine,                       8,  PL_V2,                           ST_NONE)
VGL_ENTRY(grDrawPlanarPolygonVertexList,    8,  PL_VLIST,                        ST_NONE)
VGL_ENTRY(grDrawPolygonVertexList,          8,  PL_VLIST,                        ST_NONE)
VGL_ENTRY(grDrawTriangle,                  12,  PL_V3,                           ST_NONE)
VGL_ENTRY(grErrorSetCallback,               4,  PL_CALLBACK,                     ST_NONE)
VGL_ENTRY(grFogColorValue,                  4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(grFogMode,                        4,  PL_NONE,                         ST_DRAW)
