VGL_ENTRY(grTexTextureMemRequired,          8,  PL_TEXINFO1,                     ST_NONE)
VGL_ENTRY(guColorCombineFunction,           4,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(guTexCombineFunction,             8,  PL_NONE,                         ST_DRAW)
VGL_ENTRY(guTexMemReset,                    0,  PL_NONE,                         ST_NONE)
