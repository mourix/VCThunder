 * it as gpu_shader_dxbc.h, one vgl_dxbc_<entry> array each.
 */
VGL_SHADER(main_vs, "vs_5_1")
VGL_SHADER(main_ps, "ps_5_1")
VGL_SHADER(copy_vs, "vs_5_1")
VGL_SHADER(overlay_ps, "ps_5_1")
VGL_SHADER(clear_ps, "ps_5_1")
VGL_SHADER(depth_resolve_ps, "ps_5_1")
VGL_SHADER(over_ps, "ps_5_1")
VGL_SHADER(upscale_bilinear_ps, "ps_5_1")
VGL_SHADER(clear_layer_ps, "ps_5_1")
VGL_SHADER(clear_layer_color_ps, "ps_5_1")
VGL_SHADER(layer_depth_ps, "ps_5_1")
VGL_SHADER(compose_ps, "ps_5_1")
VGL_SHADER(upscale_catmull_ps, "ps_5_1")
VGL_SHADER(fsr_easu_ps, "ps_5_1")
VGL_SHADER(fsr_rcas_ps, "ps_5_1")
VGL_SHADER(bezel_ps, "ps_5_1")
VGL_SHADER(gamma_ps, "ps_5_1")
