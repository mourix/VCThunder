/* ---- Not shown, and not shipped ---------------------------------------- */
/*
 * Parsed wherever they are found, absent from vcthunder.ini, and absent
 * from the launcher's array on purpose: save_settings() writes every entry of
 * that array back to the file, so one of these in it would be injected into
 * the user's ini the first time they opened the window.
 * docs/configuration.md §6 says what they are and why none of them ships.
 */
/* Empty on purpose: both paths are derived from the selected title once it is
 * known (game_resolve_paths). A default of data\HYDRO.EXE would silently win
 * over an Offroad-only pack. --exe overrides it from the command line. */
SETTING_DEV("paths", "exe",
        STORE(VCT_STORE_STR, exe, "", NULL, 0, 0))
/* Only `sim` is implemented; `serial` is M6's, when there is a board to reach.
 * The selector is parsed so asking for one that is not built yet gets diego.c's
 * explicit warning, but it is not advertised in the shipped file. */
SETTING_DEV("controls", "backend",
        STORE(VCT_STORE_STR, io_backend, "sim", NULL, 0, 0))
SETTING_DEV("controls", "port",
        STORE(VCT_STORE_STR, io_port, "", NULL, 0, 0))
/* The developer switches. Each is off by default, each ruins or slows
 * something on purpose, and each stays implemented to re-falsify a closed
 * result. docs/configuration.md §6 says why none of them ships. */
SETTING_DEV("diagnostics", "profile_ms",
        STORE(VCT_STORE_UINT, profile_ms, "0", NULL, 0, 100))
SETTING_DEV("diagnostics", "time_calls",
        STORE(VCT_STORE_BOOL, time_calls, "false", NULL, 0, 0))
/* On, and it should stay on: unfenced, the timer's two rdtsc reads retire
 * together and the interval is not the interval that elapsed. */
SETTING_DEV("diagnostics", "time_fence",
        STORE(VCT_STORE_BOOL, time_fence, "true", NULL, 0, 0))
SETTING_DEV("diagnostics", "glide_timing",
        STORE(VCT_STORE_BOOL, glide_timing, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "glide_first_call",
        STORE(VCT_STORE_BOOL, glide_first_call, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "win32_counting",
        STORE(VCT_STORE_BOOL, win32_counting, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "count_loops",
        STORE(VCT_STORE_BOOL, count_loops, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "margin_census",
        STORE(VCT_STORE_BOOL, margin_census, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "margin_trace",
        STORE(VCT_STORE_BOOL, margin_trace, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "null_draw",
        STORE(VCT_STORE_UINT, null_draw, "0", NULL, 0, 3))
SETTING_DEV("diagnostics", "null_water",
        STORE(VCT_STORE_BOOL, null_water, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "null_fog",
        STORE(VCT_STORE_BOOL, null_fog, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "no_additive_light",
        STORE(VCT_STORE_BOOL, no_additive_light, "false", NULL, 0, 0))
SETTING_DEV("diagnostics", "trace_draw_state",
        STORE(VCT_STORE_UINT, trace_draw_state, "0", NULL, 0, 86400))
