        STORE_ELSEWHERE("100", NULL, 5, 100),
        SHOW_NEVER)

/* The one instruction the host gives a user whose wheel will not steer is "run
 * with input_trace = true and use the axis that moves" (dinput.c), so the
 * launcher must be able to set it. It lives on the controls page rather than
 * with the other diagnostics because that is where somebody hunting an axis
 * already is. */
SETTING("diagnostics", "input_trace",
        STORE_ELSEWHERE("false", NULL, 0, 0),
        SHOW(PAGE_CONTROLS, "Write every axis and button to the log", ST_BOOL,
             SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE,
             "Names what the device actually reports, which is how an axis "
             "gets mapped; noisy, so leave it off for play."))

/* ---- PAGE_FFB: [ffb], read by dinput.c --------------------------------- */
SETTING("ffb", "enabled",
        STORE_ELSEWHERE("true", NULL, 0, 0),
        SHOW(PAGE_FFB, "Enable force feedback", ST_BOOL,
             SF_NONE, WARNING_NONE, NULL))
/* `direction` AND NOT `invert`: the old key's default was `true`, and `true` is
 * what every wheel measured here wants, so the file said "inverted" about the
 * ordinary case. dinput.c still reads the old key and warns. `normal` is the
 * old `true`. */
SETTING("ffb", "direction",
        STORE_ELSEWHERE("normal", "normal|reversed", 0, 0),
        SHOW(PAGE_FFB, "Motor direction", ST_ENUM,
             SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE,
             "Which way the wheel pushes. Normal suits every wheel measured "
             "here; choose reversed only if it pulls you out of a corner "
             "instead of resisting."))
