/* ---- PAGE_LINK: [link], the arcade link's transport -------------------- */
/* Both titles carry packets here with two instances on one machine:
 * discovery, a linked race, and a peer dropping and recovering. Two machines
 * and a cabinet have not been tried, so `off` stays the default and `lan` says
 * in its own help that its second machine is unmeasured. Whether the link is
 * enabled and which unit this cabinet is stay the GAME'S own operator
 * settings, in NVRAM: nothing here duplicates them, because two places to set
 * one thing is a trap, and the launcher page says so on screen. */
SETTING("link", "link",
        STORE(VCT_STORE_ENUM, link, "off", "off|lan|local", 0, 0),
        SHOW(PAGE_LINK, "Arcade link", ST_ENUM, SF_NONE, WARNING_CAUTION,
             "Local is two instances on this machine; lan is a second machine, "
             "which has never been measured."))
SETTING("link", "link_rx_budget",
        STORE(VCT_STORE_UINT, link_rx_budget, "64", NULL, 1, 4096),
        SHOW(PAGE_LINK, "Receive budget (datagrams per frame)", ST_UINT,
             SF_NONE, WARNING_NONE,
             "Hydro's drain has no upper bound of its own; this supplies one."))

