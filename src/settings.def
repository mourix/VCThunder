        STORE_ELSEWHERE("100", NULL, 0, 200),
        SHOW(PAGE_FFB, "Game-force scale (%)", ST_UINT,
             SF_NONE, WARNING_NONE, NULL))
SETTING("ffb", "device_gain_percent",
        STORE_ELSEWHERE("100", NULL, 0, 100),
        SHOW(PAGE_FFB, "Device gain (%)", ST_UINT,
             SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE, NULL))
