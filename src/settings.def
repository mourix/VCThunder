/* ---- PAGE_CONTROLS: [analog], read by diego.c and dinput.c --------------
 *
 * EVERY KEY HERE IS `SF_ADVANCED` AND `SF_UNSHIPPED`. What a user does on the
 * Controls page is pick the controller that drives the car, press `Set up...`
 * and let the three steps MEASURE the axes, and press buttons to bind them.
 * Every row below is the manual form of something that page does by
 * measurement, kept because a wheel that is not plugged in yet still has to be
 * configurable by hand and because the measurement can refuse. They are one
 * click away, under `Advanced`.
 *
 * SF_UNSHIPPED is the other half: the shipped vcthunder.ini does not carry a
 * key whose value is the table's own default. `Set up...` and `Use this
 * controller` write exactly the lines they change, into the device's own
 * [analog.<label>] section, so a file that says three things says three things
 * instead of thirty that all agree with the compiled default.
 */
SETTING("analog", "provider",
        STORE_ELSEWHERE("auto", "auto|dinput|xinput|winmm|none", 0, 0),
        SHOW(PAGE_CONTROLS, "How the controller is read", ST_ENUM,
             SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE,
             "Automatic prefers a wheel with force feedback and falls through "
             "to a gamepad. Pinning one is for a controller two of these can "
             "see and only one can read."))
SETTING("analog", "deadzone_percent",
        STORE_ELSEWHERE("12", NULL, 0, 49),
        SHOW(PAGE_CONTROLS, "Gamepad: ignore near centre (%)", ST_UINT, SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE,
             "A thumbstick does not return exactly to centre; this is how much "
             "of the middle counts as not moved. A wheel has its own below."))
/* `auto` ASKS THE OPENED DEVICE. `true` sends a hat press to full lock, which
 * on a wheel is a crash, and false is right there; auto gets it without the
 * user having to know. true/false still parse and still win, so an existing
 * configuration does not move. io_config_pov_digital() resolves it and says in
 * the log which way it went. */
SETTING("analog", "pov_digital",
        STORE_ELSEWHERE("auto", "auto|true|false", 0, 0),
        SHOW(PAGE_CONTROLS, "Let the D-pad or hat steer", ST_ENUM,
             SF_ADVANCED | SF_UNSHIPPED, WARNING_NONE,
             "Automatic turns it off for a force-feedback wheel, where a hat "
             "press means full lock, and on for anything else."))
