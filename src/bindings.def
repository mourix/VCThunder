/* bindings.def -- every cabinet control this host binds, once.
 * SPDX-License-Identifier: MIT.  Copyright (c) 2026 VCThunder contributors.
 *
 * ONE table, three consumers reading different columns: io_config.c the
 * defaults and the ini keys, io_board.c the switch line each button lands on,
 * launcher.c the labels and those same defaults as the text it writes back. No
 * second copy of any column: a binding in one consumer and missing from another
 * is a control the user can configure and the cabinet never reads. Same
 * arrangement as src/settings.def.
 */

/* ---- the row --------------------------------------------------------------
 *
 *      BINDING(key, hydro, offroad, pad_hydro, pad_offroad, button,
 *              hydro_label, offroad_label)
 *          A control with both halves: a keyboard key in [digital] and a
 *          controller button ordinal in [gamepad].
 *
 *      BINDING_AXIS(key, hydro, offroad, hydro_label, offroad_label)
 *          Keyboard only. MAME's digital increment/decrement inputs for an
 *          analogue field; a controller drives the axis itself.
 *
 *      BINDING_PAD(key, pad_hydro, pad_offroad, hydro_label, offroad_label)
 *          Controller only: Offroad's three-position gate as two paddles,
 *          which no keyboard key corresponds to (the three gears do).
 *
 * `key` is a bare identifier and three things at once: the ini key in BOTH
 * sections, the `controls_config_t` member holding the resolved key code, and,
 * with a `pad_` prefix, the member holding the ordinal. A row cannot name one
 * of those and not the others.
 *
 * `hydro` and `offroad` are MAME key NAMES, not key codes, so a default goes
 * through parse_vk() exactly as a value from the file does. `NONE` is a real
 * answer: the cabinet has no such control.
 *
 * `pad_hydro` and `pad_offroad` are the same per-title split for the controller
 * half, 0 meaning unbound. TWO COLUMNS AND NOT ONE: a shared column cannot
 * express "the shifter paddles, on the cabinet that has a shifter" without also
 * offering them on the cabinet that does not.
 *
 * `button` is the logical switch line in src/io.h, or BTN_NONE for a control
 * that is not one: the coin slots are counters, and the shifter paddles drive
 * a latch that produces one of the three gear lines.
 *
 * A NULL `hydro_label` means the control is Offroad's alone; the launcher hides
 * it while Hydro is selected. */

/* ---- coins and the operator panel --------------------------------------- */
BINDING     (coin1,        "5",      "5",      7, 7, BTN_NONE,
             "Coin 1",      "Coin 1")
BINDING     (coin2,        "6",      "6",      0, 0, BTN_NONE,
             "Coin 2",      "Coin 2")
BINDING     (start1,       "1",      "1",      8, 8, BTN_START,
             "Start",       "Start")
BINDING     (service1,     "9",      "9",      0, 0, BTN_SERVICE,
             "Service credit", "Service credit")
BINDING     (service_mode, "F2",     "F2",     0, 0, BTN_TEST,
             "Operator menu", "Operator menu")

/* ---- the analogue fields, as digital overrides --------------------------- */
BINDING_AXIS(steer_left,   "LEFT",   "LEFT",
             "Steer left",  "Steer left")
BINDING_AXIS(steer_right,  "RIGHT",  "RIGHT",
             "Steer right", "Steer right")
/* Offroad has a pedal box where Hydro has a throttle lever, so gas and brake
 * move off the arrows onto Ctrl and Alt. That frees the modifiers Hydro used
 * for its views, which is why the two cabinets disagree from here down. */
BINDING_AXIS(throttle,     "UP",     "LCTRL",
             "Throttle",    "Throttle")
BINDING_AXIS(brake,        "DOWN",   "LALT",
             "Brake",       "Brake")

/* ---- what the player's hands are on -------------------------------------- */
/* BOOST IS THE BOTTOM FACE BUTTON ON PURPOSE AND MUST NOT MOVE TO A SHOULDER.
 * On Hydro it is not only the in-race boost: the cabinet's own manual has it
 * begin or continue play and select the boat and the track, so it is the one
 * control a player needs before they know any of the others. That is why it
 * gets the most discoverable button on the pad, why both cabinets agree on it,
 * and why no camera convention from a modern racing game is a reason to
 * rearrange the four face buttons around it. */
BINDING     (boost,        "LCTRL",  "SPACE",  1, 1, BTN_BOOST,
             "Boost",       "Nitro")
BINDING     (view_high,    "LALT",   "V",      2, 2, BTN_VIEW1,
             "High view",   "Slam cam")
BINDING     (view_low,     "SPACE",  "B",      3, 3, BTN_VIEW2,
             "Low view",    "Chase cam")
BINDING     (view_pilot,   "LSHIFT", "N",      4, 4, BTN_VIEW3,
             "Pilot view",  "Chopper cam")
BINDING     (volume_down,  "MINUS",  "MINUS",  0, 0, BTN_VOL_DN,
             "Volume down", "Volume down")
BINDING     (volume_up,    "EQUALS", "EQUALS", 0, 0, BTN_VOL_UP,
             "Volume up",   "Volume up")

/* ---- Offroad's three-speed shifter --------------------------------------- */
/* Maintained lines, not edges: no SHIFT bit set is how the game derives
 * neutral. Hydro has no shifter, so its default is NONE rather than a key it
 * would ignore. */
BINDING     (shift1,       "NONE",   "Z",      0, 0, BTN_SHIFT1,
             NULL,          "Gear 1")
BINDING     (shift2,       "NONE",   "X",      0, 0, BTN_SHIFT2,
             NULL,          "Gear 2")
BINDING     (shift3,       "NONE",   "C",      0, 0, BTN_SHIFT3,
             NULL,          "Gear 3")
/* The same gate on two paddles: each rising edge steps a latch that produces
 * one of the three lines above. See sequential_shift() in io_board.c.
 *
 * 6 AND 5 ARE RB AND LB, and they are Offroad's alone. A pad's four face
 * buttons are already spent (NITRO and the three cameras), so the gate cannot
 * go there, and three face buttons standing for three MAINTAINED gear states
 * is not a thing a pad player reads. Two paddles are, and the cabinet's own
 * manual explains the transmission as upshifting and downshifting. Hydro gets
 * 0: it has no shifter, and its Diego payload carries no SHIFT line
 * (build_payload_diego).
 *
 * The ordinals are XInput's own: xi_buttons() in io_host.c maps LEFT_SHOULDER
 * and RIGHT_SHOULDER to bits 4 and 5, which are ordinals 5 and 6. A DirectInput
 * wheel numbers its paddles for itself, which is what the launcher's
 * press-to-bind is for. */
BINDING_PAD (shift_up,                         0, 6,
             NULL,          "Shift up")
BINDING_PAD (shift_down,                       0, 5,
             NULL,          "Shift down")
